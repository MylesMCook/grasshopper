{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "\"${PLUGIN_ROOT}/bin/grasshopper.exe\" hook --harness codex", "commandWindows": "for %G in (\"%PLUGIN_ROOT%/bin/grasshopper.exe\") do @%G hook --harness codex", "timeout": 8}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "\"${PLUGIN_ROOT}/bin/grasshopper.exe\" hook --harness codex", "commandWindows": "for %G in (\"%PLUGIN_ROOT%/bin/grasshopper.exe\") do @%G hook --harness codex", "timeout": 8}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "true", "commandWindows": "for %G in (\"%PLUGIN_ROOT%/bin/grasshopper.exe\") do @%G hook --harness codex", "timeout": 8}]}]
  }
}
