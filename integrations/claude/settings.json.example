{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"ABSOLUTE_GRASSHOPPER_BINARY\" hook --config \"ABSOLUTE_CLIENT_CONFIG\" --harness claude",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "\"ABSOLUTE_GRASSHOPPER_BINARY\" hook --config \"ABSOLUTE_CLIENT_CONFIG\" --harness claude --global-part 1",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "\"ABSOLUTE_GRASSHOPPER_BINARY\" hook --config \"ABSOLUTE_CLIENT_CONFIG\" --harness claude --global-part 2",
            "timeout": 8
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"ABSOLUTE_GRASSHOPPER_BINARY\" hook --config \"ABSOLUTE_CLIENT_CONFIG\" --harness claude",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "\"ABSOLUTE_GRASSHOPPER_BINARY\" hook --config \"ABSOLUTE_CLIENT_CONFIG\" --harness claude --global-part 1",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "\"ABSOLUTE_GRASSHOPPER_BINARY\" hook --config \"ABSOLUTE_CLIENT_CONFIG\" --harness claude --global-part 2",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
